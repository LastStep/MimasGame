{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet run *)",
      "Bash(dotnet format *)",
      "Bash(unity status *)",
      "Bash(unity command *)",
      "Bash(unity test *)",
      "Bash(unity build *)",
      "Bash(unity pipeline *)",
      "Bash(unity projects verify *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Write(**/*.meta)",
      "Edit(**/*.meta)",
      "Write(**/MimasClient/ProjectSettings/**)",
      "Edit(**/MimasClient/ProjectSettings/**)",
      "Edit(**/packages-lock.json)",
      "Read(**/MimasClient/Library/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)"
    ]
  },
  "env": {
    "MCP_TOOL_TIMEOUT": "180000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-unity-files.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"E:/Studios/Trinetra-Game-Studio/tools/hooks/guard-paths.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"E:/Studios/Trinetra-Game-Studio/tools/hooks/ledger-guard.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"E:/Studios/Trinetra-Game-Studio/tools/hooks/guard-bash.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"E:/Studios/Trinetra-Game-Studio/tools/hooks/stop-gate.mjs\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"E:/Studios/Trinetra-Game-Studio/tools/hooks/event-sink.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"E:/Studios/Trinetra-Game-Studio/tools/hooks/event-sink.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
