/*
 * The match HUD in the ink language (docs/ui/hud.md, docs/ui/between-rounds.md; spec H §7). Every colour, face,
 * size and gap is a --mimas-* token from Theme.uss: no literal colour and no --hud-* variable. Pixel positions
 * are the book's, at the 1920×1080 the panel scales from (1280×720 draws them at two thirds). No panel, no box,
 * no divider (language §4): things are separated by space and captions, and the floors under the bar and the
 * track are generated fades tinted here.
 */

@import url("Theme.uss");

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Between rounds, and while a moment holds the screen, the bar, the boons and the buttons step aside. */
.hud--between .hud-bar,
.hud--between .hud-boons,
.hud--between .hud-end,
.hud--between .hud-resign {
    display: none;
}

/* The "?" the unknown glyph sets in type, wherever the HUD draws one (tags, cards). */
.hud-root .glyph-question {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-10);
    margin: 0;
    padding: 0;
}

/* ---- the floors (hud.md §2) --------------------------------------------------------------------- */

.hud-floor {
    position: absolute;
    left: 0;
    right: 0;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-floor--bottom {
    bottom: 0;
    height: 300px;
    -unity-background-image-tint-color: var(--mimas-floor);
}

.hud-floor--top {
    top: 0;
    height: 220px;
    -unity-background-image-tint-color: var(--mimas-floor-top);
}

/* ---- the turn track (hud.md §3.1) --------------------------------------------------------------- */

.hud-track {
    position: absolute;
    top: 38px;
    left: 50%;
    width: var(--mimas-track-w);
    translate: -50% 0;
    flex-direction: column;
}

.hud-track__head {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 22px;
}

.hud-track__end {
    flex-direction: row;
    align-items: center;
}

.hud-track__name {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-15);
    letter-spacing: var(--mimas-tracking-15);
    color: var(--mimas-fg-3);
    margin: 0;
    padding: 0;
}

.hud-track__name--you {
    margin-right: 12px;
}

.hud-track__name--them {
    margin-left: 12px;
}

.hud-track--mine .hud-track__name--you {
    color: var(--mimas-you);
}

.hud-track--theirs .hud-track__name--them {
    color: var(--mimas-them);
}

.hud-track__pips {
    flex-direction: row;
    align-items: center;
}

.hud-pip {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--mimas-fg-3);
    margin: 0 2px;
}

.hud-track__pips--you .hud-pip--won {
    border-color: var(--mimas-you);
    background-color: var(--mimas-you);
}

.hud-track__pips--them .hud-pip--won {
    border-color: var(--mimas-them);
    background-color: var(--mimas-them);
}

.hud-track__round {
    position: absolute;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-fg-3);
    margin: 0;
    padding: 0;
}

/* The line: a 2px hair, the lit half on top of it, the centre tick, the marker or the ember. */
.hud-track__line {
    height: 14px;
    margin-top: 14px;
}

.hud-track__hair {
    position: absolute;
    left: 0;
    right: 0;
    top: 6px;
    height: var(--mimas-bar);
    background-color: var(--mimas-hair);
}

.hud-track__fill {
    position: absolute;
    top: 6px;
    height: var(--mimas-bar);
    left: 0;
    width: 50%;
    background-color: var(--mimas-you);
    display: none;
}

.hud-track--theirs .hud-track__fill {
    background-color: var(--mimas-them);
}

.hud-track--lit .hud-track__fill {
    display: flex;
}

.hud-track__tick {
    position: absolute;
    left: 50%;
    top: 0;
    width: 2px;
    height: 14px;
    margin-left: -1px;
    background-color: var(--mimas-fg-3);
}

.hud-track__marker {
    position: absolute;
    top: 0;
    left: 25%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 7px;
    background-color: var(--mimas-you);
    display: none;
}

.hud-track--theirs .hud-track__marker {
    left: 75%;
    background-color: var(--mimas-them);
}

.hud-track--lit .hud-track__marker {
    display: flex;
}

/* The rope's last seconds: the marker gives way to the ember at the burning end. */
.hud-track--burning .hud-track__marker {
    display: none;
}

.hud-track__ember {
    position: absolute;
    top: 0;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    align-items: center;
    justify-content: center;
    display: none;
}

.hud-track--burning .hud-track__ember {
    display: flex;
}

.hud-track__glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--mimas-you);
    opacity: 0.35;
}

.hud-track--theirs .hud-track__glow {
    background-color: var(--mimas-them);
}

.hud-track__spark {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--mimas-fg);
}

.hud-track__under {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 10px;
    height: 16px;
}

.hud-track__note {
    flex-direction: row;
    align-items: center;
    display: none;
}

.hud-track__note--visible {
    display: flex;
}

.hud-track__note-text {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--mimas-fg-2);
    margin: 0 8px 0 0;
    padding: 0;
}

.hud-track__dot {
    width: 7px;
    height: 7px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--mimas-them);
    background-color: var(--mimas-them);
}

.hud-track__dot--hollow {
    background-color: var(--mimas-clear);
}

/* ---- the bar: action points and the lane rows (hud.md §3.2) --------------------------------------- */

.hud-bar {
    position: absolute;
    left: var(--mimas-edge);
    bottom: var(--mimas-edge);
    flex-direction: row;
    align-items: flex-end;
}

/* Their turn: not yours to act, so the whole bar steps back (language §5 state.their-turn). */
.hud-bar--theirs {
    opacity: 0.45;
}

.hud-ap {
    flex-direction: column;
    margin-right: 44px;
}

.hud-ap__caption {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-10);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-fg-3);
    margin: 0 0 6px 0;
    padding: 0;
}

.hud-ap__value {
    flex-direction: row;
    align-items: flex-end;
    height: 42px;
}

.hud-ap__bolt {
    width: 20px;
    height: 20px;
    margin: 0 10px 9px 0;
    --glyph-color: var(--mimas-you);
}

.hud-ap__current {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-38);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
}

.hud-ap__max {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-14);
    color: var(--mimas-fg-3);
    margin: 0 0 8px 8px;
    padding: 0;
}

.hud-ap__eggs {
    flex-direction: row;
    margin-top: 8px;
}

/* One egg per AP per turn (language §3 glyph.egg, drawn in USS): held, spent, and what the hovered or armed
   action would spend (state.spends). */
.hud-egg {
    width: 12px;
    height: 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--mimas-fg-3);
    background-color: var(--mimas-clear);
    margin-right: 6px;
}

.hud-egg--held {
    border-color: var(--mimas-you);
    background-color: var(--mimas-you);
}

.hud-egg--spends {
    border-color: var(--mimas-you);
    background-color: var(--mimas-you-28);
}

.hud-lanes {
    flex-direction: column;
}

.hud-lane {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.hud-lane--empty {
    display: none;
}

.hud-lane__caption {
    width: 120px;
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-fg-3);
    margin: 0;
    padding: 0;
}

.hud-lane__tiles {
    flex-direction: row;
}

/* ---- a tile (hud.md §3.2, language §5) ------------------------------------------------------------ */

.hud-tile {
    width: var(--mimas-tile-size);
    height: var(--mimas-tile-size);
    margin-right: 12px;
    background-color: var(--mimas-tile);
    border-width: 1px;
    border-color: var(--mimas-hair);
    align-items: center;
    justify-content: center;
}

.hud-tile:hover {
    background-color: var(--mimas-hover);
}

.hud-tile__icon {
    position: absolute;
    left: 8px;
    top: 6px;
    right: 8px;
    bottom: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-tile__letter {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-17);
    color: var(--mimas-fg);
    margin: 0 0 6px 0;
    padding: 0;
}

/* The cost as dots inside the tile, never a digit (language §3 glyph.cost). */
.hud-tile__cost {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 5px;
    flex-direction: row;
    justify-content: center;
}

.hud-tile__dot {
    width: 5px;
    height: 5px;
    border-radius: 3px;
    margin: 0 1.5px;
    background-color: var(--mimas-you);
}

/* A boon changed it (diamond) or a Sigil added it (triangle): the violet edge and the mark. */
.hud-tile__mark {
    position: absolute;
    right: -5px;
    top: -5px;
    width: 10px;
    height: 10px;
    --glyph-color: var(--mimas-changed);
    display: none;
}

.hud-tile--changed,
.hud-tile--added {
    border-color: var(--mimas-changed);
}

.hud-tile--changed .hud-tile__mark,
.hud-tile--added .hud-tile__mark {
    display: flex;
}

/* Not yet seen by the opponent: a closed eye at the top-left (language §5 state.unseen-by-them). */
.hud-tile__eye {
    position: absolute;
    left: 4px;
    top: 4px;
    width: 11px;
    height: 11px;
    --glyph-color: var(--mimas-fg-3);
    display: none;
}

.hud-tile--unseen .hud-tile__eye {
    display: flex;
}

/* Armed wins over the changed edge (spec H §7.4: the specificity trap). */
.hud-tile.hud-tile--armed {
    border-width: 2px;
    border-color: var(--mimas-you);
    background-color: var(--mimas-you-10);
}

.hud-tile--unaffordable {
    opacity: 0.36;
}

.hud-tile--unaffordable .hud-tile__dot {
    background-color: var(--mimas-fg-3);
}

/* ---- your boons (hud.md §3.3) --------------------------------------------------------------------- */

.hud-boons {
    position: absolute;
    right: var(--mimas-edge);
    top: 380px;
    flex-direction: column;
}

.hud-boon {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--mimas-hair);
    background-color: var(--mimas-ink-55);
    margin-bottom: 12px;
    align-items: center;
    justify-content: center;
}

.hud-boon:hover {
    border-color: var(--mimas-fg-3);
}

.hud-boon__glyph {
    width: 14px;
    height: 14px;
    --glyph-color: var(--mimas-you);
}

/* ---- End Turn and Resign (hud.md §3.4) ------------------------------------------------------------ */

.hud-end {
    position: absolute;
    right: var(--mimas-edge);
    bottom: var(--mimas-edge);
    width: var(--mimas-button-w);
    height: var(--mimas-button-h);
    margin: 0;
    padding: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--mimas-you-55);
    background-color: var(--mimas-ink-55);
    align-items: center;
    justify-content: center;
}

.hud-end:hover {
    background-color: var(--mimas-you-10);
    border-color: var(--mimas-you);
}

.hud-end:active {
    background-color: var(--mimas-you-14);
}

.hud-end__label {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-15);
    letter-spacing: var(--mimas-tracking-15);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
}

/* Nothing left to spend: one click ends it (language §5 state.done). */
.hud-end--done {
    border-color: var(--mimas-you);
    background-color: var(--mimas-you-18);
}

.hud-end--done .hud-end__label {
    color: var(--mimas-you);
}

.hud-end--theirs,
.hud-end--theirs:hover {
    border-color: var(--mimas-hair);
    background-color: var(--mimas-ink-55);
}

.hud-end--theirs .hud-end__label {
    color: var(--mimas-fg-3);
}

.hud-resign {
    position: absolute;
    right: var(--mimas-edge);
    bottom: 114px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-color: var(--mimas-clear);
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-fg-3);
    -unity-text-align: middle-right;
    display: none;
}

.hud-resign:hover,
.hud-resign:active {
    background-color: var(--mimas-clear);
    color: var(--mimas-fg-2);
}

.hud-resign--visible {
    display: flex;
}

/* The first click asks again, in their colour, for three seconds. */
.hud-resign--armed,
.hud-resign--armed:hover {
    color: var(--mimas-them);
}

/* ---- unit tags (hud.md §3.5) ---------------------------------------------------------------------- */

.unit-layer,
.fly-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.hud-tag {
    position: absolute;
    translate: -50% -100%;
    flex-direction: column;
    align-items: center;
    opacity: 0.55;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.hud-tag--emphasised {
    opacity: 1;
}

.hud-tag--dead {
    display: none;
}

.hud-tag__number {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 4px;
}

.hud-tag__hp {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-19);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
    text-shadow: 0 1px 3px var(--mimas-ink);
}

.hud-tag__max {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    color: var(--mimas-fg-3);
    margin: 0 0 2px 5px;
    padding: 0;
    text-shadow: 0 1px 3px var(--mimas-ink);
}

.hud-tag__bar {
    width: 84px;
    height: var(--mimas-bar);
    flex-direction: row;
    background-color: var(--mimas-ink-50);
}

.hud-tag__fill {
    height: var(--mimas-bar);
    background-color: var(--mimas-you);
}

.hud-tag--theirs .hud-tag__fill {
    background-color: var(--mimas-them);
}

.hud-tag--prop .hud-tag__fill {
    background-color: var(--mimas-fg-2);
}

/* What an armed attack would take, at the fill's right end, in the damage colour. */
.hud-tag__ghost {
    height: var(--mimas-bar);
    background-color: var(--mimas-amount);
}

.hud-tag__marks {
    flex-direction: row;
    margin-top: 5px;
}

.hud-tag__mark {
    width: 9px;
    height: 9px;
    margin: 0 2px;
    --glyph-color: var(--mimas-them);
}

.hud-tag__mark--unknown {
    width: 10px;
    height: 10px;
    --glyph-color: var(--mimas-fg-3);
    color: var(--mimas-fg-3);
}

.hud-tag__lineage {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-10);
    letter-spacing: var(--mimas-caps-tracking);
    color: var(--mimas-fg-3);
    margin: 3px 0 0 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* ex.ring: a 1px ring in the owner's colour around the examined unit's tag (language §5 state.selected). */
.ex-ring {
    position: absolute;
    left: -8px;
    right: -8px;
    top: -5px;
    bottom: -5px;
    border-width: 1px;
    border-color: var(--mimas-you);
    display: none;
}

.hud-tag--theirs .ex-ring {
    border-color: var(--mimas-them);
}

.hud-tag--examined .ex-ring {
    display: flex;
}

/* ---- flyovers and the cursor tag (hud.md §3.6) ---------------------------------------------------- */

.hud-fly {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.hud-fly__amount {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-36);
    color: var(--mimas-amount);
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 6px var(--mimas-ink);
}

.hud-fly__head {
    flex-direction: row;
    align-items: center;
}

.hud-fly__glyph {
    width: 12px;
    height: 12px;
    margin-right: 8px;
    --glyph-color: var(--mimas-them);
}

.hud-fly__headline {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-13);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
    text-shadow: 0 1px 4px var(--mimas-ink);
}

.hud-fly__detail {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-10);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--mimas-fg-3);
    margin: 4px 0 0 0;
    padding: 0;
    text-shadow: 0 1px 4px var(--mimas-ink);
}

.hud-cursor {
    position: absolute;
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-12);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--mimas-fg);
    background-color: var(--mimas-ink-82);
    padding: 9px 14px 9px 14px;
    margin: 0;
    display: none;
}

.hud-cursor--visible {
    display: flex;
}

/* ---- the draft (between-rounds.md §2) ------------------------------------------------------------- */

.dr-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.dr-root--open {
    display: flex;
}

/* The board under ink at 80%: one element, and it dims the heroes too. */
.dr-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--mimas-scrim);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}

.dr-root--shown .dr-scrim {
    opacity: 1;
}

.dr-headline {
    position: absolute;
    left: 0;
    right: 0;
    top: 164px;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-20);
    letter-spacing: var(--mimas-tracking-20);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
}

.dr-next {
    position: absolute;
    left: 0;
    right: 0;
    top: 204px;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-fg-3);
    margin: 0;
    padding: 0;
}

.dr-cards {
    position: absolute;
    left: 0;
    right: 0;
    top: 300px;
    flex-direction: row;
    justify-content: center;
}

.dr-card {
    width: var(--mimas-card-w);
    height: var(--mimas-card-h);
    margin: 0 22px;
    padding: 0;
    border-radius: 0;
    border-width: 0;
    background-color: var(--mimas-clear);
    flex-direction: column;
    align-items: stretch;
    justify-content: flex-start;
    transition-property: translate, opacity;
    transition-duration: 0.12s;
}

.dr-card:hover,
.dr-card:active,
.dr-card:focus {
    background-color: var(--mimas-clear);
}

/* USS has no box-shadow: an offset layer in the shadow token stands in for it (language §4 drift). */
.dr-card__shadow {
    position: absolute;
    left: 8px;
    right: -8px;
    top: var(--mimas-shadow-offset);
    bottom: -14px;
    background-color: var(--mimas-shadow-panel);
    opacity: 0.55;
}

.dr-card__face {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--mimas-ink-2);
    border-left-width: 2px;
    border-color: var(--mimas-ink-2);
    flex-direction: column;
}

.dr-card:hover .dr-card__face {
    border-color: var(--mimas-hair);
}

.dr-card--selected {
    translate: 0 -14px;
}

.dr-card--selected .dr-card__face,
.dr-card--selected:hover .dr-card__face {
    border-color: var(--mimas-you);
}

.dr-card--dim {
    opacity: 0.45;
}

.dr-card__wash {
    height: 130px;
    flex-shrink: 0;
    -unity-background-scale-mode: stretch-to-fill;
    justify-content: flex-end;
    padding: 0 24px 14px 24px;
}

.dr-card__kind {
    flex-direction: row;
    align-items: center;
}

.dr-card__kind-glyph {
    width: 16px;
    height: 16px;
    margin-right: 10px;
    --glyph-color: var(--mimas-you);
}

.dr-card__kind-text {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-12);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-you);
    margin: 0;
    padding: 0;
}

.dr-card__body {
    flex-grow: 1;
    flex-direction: column;
    padding: 18px 24px 0 24px;
}

.dr-card__name {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-28);
    letter-spacing: var(--mimas-caps-tracking);
    color: var(--mimas-fg);
    white-space: normal;
    margin: 0;
    padding: 0;
    -unity-text-align: upper-left;
}

.dr-card__god {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--mimas-fg-3);
    margin: 10px 0 0 0;
    padding: 0;
    -unity-text-align: upper-left;
}

.dr-card__text {
    -unity-font-definition: var(--mimas-font-body);
    font-size: var(--mimas-text-15);
    color: var(--mimas-fg-2);
    white-space: normal;
    margin: 18px 0 0 0;
    padding: 0;
    -unity-text-align: upper-left;
}

.dr-card__on {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 26px;
    flex-direction: row;
    align-items: center;
}

.dr-card__on-glyph {
    width: 14px;
    height: 14px;
    margin-right: 10px;
    --glyph-color: var(--mimas-fg-2);
}

.dr-card__on-text {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-fg-2);
    margin: 0;
    padding: 0;
}

/* The rope language on a 520 line, burning the whole 20 s. */
.dr-timer {
    position: absolute;
    top: 846px;
    left: 50%;
    width: 520px;
    height: 8px;
    margin-left: -260px;
}

.dr-timer__hair {
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    height: var(--mimas-bar);
    background-color: var(--mimas-hair);
}

.dr-timer__fill {
    position: absolute;
    left: 0;
    top: 3px;
    height: var(--mimas-bar);
    width: 100%;
    background-color: var(--mimas-you);
}

.dr-timer__ember {
    position: absolute;
    top: 0;
    left: 100%;
    width: 8px;
    height: 8px;
    margin-left: -4px;
    border-radius: 4px;
    background-color: var(--mimas-fg);
}

.dr-confirm {
    position: absolute;
    top: 874px;
    left: 50%;
    width: var(--mimas-button-w);
    height: var(--mimas-button-h);
    margin: 0 0 0 -115px;
    padding: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--mimas-you);
    background-color: var(--mimas-you-14);
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-15);
    letter-spacing: var(--mimas-tracking-15);
    color: var(--mimas-fg);
    -unity-text-align: middle-center;
}

.dr-confirm:hover {
    background-color: var(--mimas-you-18);
    border-color: var(--mimas-you);
}

.dr-confirm:disabled {
    border-color: var(--mimas-hair);
    background-color: var(--mimas-ink-55);
    color: var(--mimas-fg-3);
    opacity: 1;
}

.dr-status {
    position: absolute;
    left: 0;
    right: 0;
    top: 948px;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--mimas-font-body);
    font-size: var(--mimas-text-12);
    color: var(--mimas-fg-3);
    margin: 0;
    padding: 0;
    display: none;
}

.dr-status--visible {
    display: flex;
}

/* ---- the round moments, in the band (between-rounds.md §3) --------------------------------------- */

.mo-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
}

.mo-root--visible {
    display: flex;
}

/* Ink at 86% across the middle, 300 tall, fading over the outer 22% each side. */
.mo-band {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 300px;
    margin-top: -150px;
    -unity-background-image-tint-color: var(--mimas-band);
    -unity-background-scale-mode: stretch-to-fill;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.mo-kicker {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-15);
    letter-spacing: var(--mimas-tracking-15);
    color: var(--mimas-fg-2);
    margin: 0 0 10px 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.mo-kicker--result {
    font-size: var(--mimas-text-20);
    letter-spacing: var(--mimas-tracking-20);
}

.mo-title {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-38);
    letter-spacing: var(--mimas-tracking-38);
    color: var(--mimas-fg);
    margin: 0 0 12px 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.mo-score {
    flex-direction: row;
    align-items: center;
    margin: 0 0 12px 0;
}

.mo-score__mine,
.mo-score__theirs {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-38);
    margin: 0;
    padding: 0;
}

.mo-score__mine {
    color: var(--mimas-you);
}

.mo-score__theirs {
    color: var(--mimas-them);
}

.mo-score__dash {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-20);
    color: var(--mimas-fg-3);
    margin: 0 20px;
    padding: 0;
}

.mo-sub {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-13);
    letter-spacing: var(--mimas-tracking-11);
    color: var(--mimas-fg-2);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* A sentence rather than a caption: how a round ended, or why the match is lost. */
.mo-sub--body {
    -unity-font-definition: var(--mimas-font-body);
    font-size: var(--mimas-text-12);
    letter-spacing: 0;
    color: var(--mimas-fg-3);
}

.mo--you {
    color: var(--mimas-you);
}

.mo--them {
    color: var(--mimas-them);
}

.mo--hidden {
    display: none;
}

.mo-back {
    width: var(--mimas-button-w);
    height: var(--mimas-button-h);
    margin: 28px 0 0 0;
    padding: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--mimas-you-55);
    background-color: var(--mimas-ink-55);
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-15);
    letter-spacing: var(--mimas-tracking-15);
    color: var(--mimas-fg);
    -unity-text-align: middle-center;
}

.mo-back:hover {
    border-color: var(--mimas-you);
    background-color: var(--mimas-you-14);
}
