/* Match HUD. Minimal chrome, four anchored panels; everything else is board. */

@import url("Theme.uss");

:root {
    --hud-panel: rgba(12, 14, 20, 0.78);
    --hud-panel-solid: rgba(12, 14, 20, 0.94);
    --hud-edge: rgba(255, 255, 255, 0.08);
    --hud-text: rgb(240, 242, 246);
    --hud-text-dim: rgba(240, 242, 246, 0.6);
    --hud-text-faint: rgba(240, 242, 246, 0.35);
    --hud-accent: rgb(120, 200, 255);
    --hud-accent-soft: rgba(120, 200, 255, 0.16);
    --hud-rope: rgb(255, 140, 60);
    --hud-ember: rgb(255, 232, 140);
    --hud-theirs: rgb(255, 176, 120);
    --hud-end: rgb(196, 74, 52);
    --hud-end-hover: rgb(226, 94, 68);
    --hud-hp: rgb(120, 230, 120);
    --hud-hp-ghost: rgb(255, 110, 90);
    --hud-hp-empty: rgba(255, 255, 255, 0.15);
    --hud-ap: rgb(120, 200, 255);
    --hud-ap-reserved: rgb(255, 110, 90);
    --hud-ap-empty: rgba(255, 255, 255, 0.12);
    --hud-plus: rgb(150, 230, 150);
    --hud-minus: rgb(255, 120, 100);
    --hud-unknown: rgb(255, 200, 90);
    --hud-fly: rgb(255, 236, 120);
}

/* ---- unit overlays --------------------------------------------------------------------------- */

.unit-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.unit-tag {
    position: absolute;
    width: 64px;
    translate: -50% -100%;
    flex-direction: column;
    align-items: center;
    opacity: 0.5;
    transition-property: opacity;
    transition-duration: 0.15s;
}

.unit-tag--emphasised {
    opacity: 1;
}

.unit-tag--dead {
    display: none;
}

.unit-bar {
    flex-direction: row;
    width: 100%;
    height: 6px;
}

.unit-seg {
    flex-grow: 1;
    height: 6px;
    margin-right: 2px;
    border-radius: 1px;
    background-color: var(--hud-hp);
}

.unit-seg--empty {
    background-color: var(--hud-hp-empty);
}

.unit-seg--ghost {
    background-color: var(--hud-hp-ghost);
}

.unit-tag--theirs .unit-seg {
    background-color: rgb(255, 176, 120);
}

.unit-tag--theirs .unit-seg--empty {
    background-color: var(--hud-hp-empty);
}

.unit-tag--theirs .unit-seg--ghost {
    background-color: var(--hud-hp-ghost);
}

.unit-tag--prop {
    width: 40px;
}

.unit-tag--prop .unit-seg {
    height: 4px;
    background-color: rgb(200, 180, 138);
}

.unit-tag--prop .unit-bar {
    height: 4px;
}

.unit-tag--prop .unit-seg--empty {
    background-color: var(--hud-hp-empty);
}

.unit-tag--prop .unit-seg--ghost {
    background-color: var(--hud-hp-ghost);
}

.unit-tag--prop .unit-number {
    font-size: 10px;
    color: var(--hud-text-dim);
}

.unit-number {
    color: var(--hud-text);
    font-size: 11px;
    -unity-font-style: bold;
    margin: 3px 0 0 0;
    padding: 0;
    text-shadow: 0 1px 3px rgb(0, 0, 0);
}

.unit-number--ghost {
    color: var(--hud-hp-ghost);
}

.unit-markers {
    flex-direction: row;
    margin-top: 2px;
}

.unit-marker {
    width: 12px;
    height: 12px;
    margin: 0 1px;
    border-radius: 6px;
    background-color: var(--hud-unknown);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}

.unit-marker-glyph {
    color: rgb(20, 16, 8);
    font-size: 8px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* ---- attack preview -------------------------------------------------------------------------- */

.preview {
    position: absolute;
    width: 210px;
    translate: -50% -100%;
    padding: 8px 10px;
    background-color: var(--hud-panel-solid);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--hud-edge);
    display: none;
}

.preview--visible {
    display: flex;
}

.preview-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4px;
}

.preview-title {
    color: var(--hud-text);
    font-size: 13px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.preview-total {
    color: var(--hud-fly);
    font-size: 17px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.preview-lines {
    flex-direction: column;
}

.preview-line {
    flex-direction: row;
    justify-content: space-between;
    padding: 1px 0;
}

.preview-line-label {
    color: var(--hud-text-dim);
    font-size: 12px;
    margin: 0;
    padding: 0;
}

.preview-line-amount {
    color: var(--hud-text);
    font-size: 12px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.preview-line--plus .preview-line-amount {
    color: var(--hud-plus);
}

.preview-line--minus .preview-line-amount {
    color: var(--hud-minus);
}

.preview-line--unknown .preview-line-label {
    color: var(--hud-unknown);
}

.preview-line--unknown .preview-line-amount {
    color: var(--hud-unknown);
}

/* The refusal reads first and the damage below it is hypothetical, so the total loses its shout. */
.preview-blocked {
    color: var(--hud-minus);
    font-size: 12px;
    -unity-font-style: bold;
    white-space: normal;
    margin: 0 0 4px 0;
    padding: 0;
    display: none;
}

.preview--blocked .preview-blocked {
    display: flex;
}

.preview--blocked .preview-total {
    color: var(--hud-text-faint);
}

/* ---- cursor tag ------------------------------------------------------------------------------ */

.cursor-tag {
    position: absolute;
    color: var(--hud-text);
    font-size: 12px;
    -unity-font-style: bold;
    padding: 3px 7px;
    background-color: var(--hud-panel-solid);
    border-radius: 5px;
    border-width: 1px;
    border-color: var(--hud-edge);
    margin: 0;
    display: none;
}

.cursor-tag--visible {
    display: flex;
}

/* ---- flyovers -------------------------------------------------------------------------------- */

.fly-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.fly {
    position: absolute;
    translate: -50% -100%;
    align-items: center;
}

.fly-headline {
    color: var(--hud-fly);
    font-size: 26px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    text-shadow: 0 2px 6px rgb(0, 0, 0);
}

.fly-detail {
    color: var(--hud-theirs);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    margin: 2px 0 0 0;
    padding: 0;
    text-shadow: 0 1px 3px rgb(0, 0, 0);
}

/* ---- opponent status ------------------------------------------------------------------------- */

/* Sits under the rope. Hidden unless the driver has something to say, which offline is never. */
.status-line {
    margin-top: 6px;
    align-self: center;
    padding: 3px 12px;
    background-color: var(--hud-panel);
    border-radius: 8px;
    color: var(--hud-theirs);
    font-size: 12px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    display: none;
}

.status-line--visible {
    display: flex;
}

/* ---- banner ---------------------------------------------------------------------------------- */

.banner-panel {
    position: absolute;
    top: 38%;
    left: 50%;
    translate: -50% -50%;
    align-items: center;
    display: none;
}

.banner-panel--visible {
    display: flex;
}

.banner {
    margin: 0;
    padding: 18px 48px;
    background-color: var(--hud-panel-solid);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--hud-edge);
    color: var(--hud-text);
    font-size: 34px;
    letter-spacing: 8px;
    -unity-font-style: bold;
}

.banner--lost {
    color: var(--hud-theirs);
}

/* How it ended, not just who won: "you resigned" and "opponent left" are different stories. */
.banner-detail {
    margin-top: 10px;
    color: var(--hud-text-dim);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

/* Appears a beat after the result, so the result lands first. */
.banner-button {
    margin-top: 22px;
    padding: 10px 24px;
    background-color: var(--hud-panel-solid);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--hud-edge);
    color: var(--hud-text);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    display: none;
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.banner-button--visible {
    display: flex;
}

.banner-button:hover {
    background-color: var(--hud-accent-soft);
    scale: 1.03 1.03;
}

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---- turn panel ------------------------------------------------------------------------------ */

.turn-panel {
    position: absolute;
    top: 16px;
    left: 50%;
    translate: -50% 0;
    min-width: 240px;
    padding: 10px 22px 10px 22px;
    align-items: center;
    background-color: var(--hud-panel);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--hud-edge);
}

.turn-owner {
    color: var(--hud-text);
    font-size: 14px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.turn-panel--theirs .turn-owner {
    color: var(--hud-theirs);
}

/* The rope: hidden until the last seconds, then burns from full width to nothing. */
.rope {
    width: 100%;
    height: 14px;
    margin-top: 8px;
    justify-content: center;
    display: none;
}

.rope--visible {
    display: flex;
}

.rope-track {
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.1);
    overflow: hidden;
}

.rope-fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-rope);
}

.rope-ember {
    position: absolute;
    top: 0;
    left: 100%;
    width: 14px;
    height: 14px;
    translate: -50% 0;
    border-radius: 7px;
    background-color: var(--hud-ember);
}

/* ---- examine --------------------------------------------------------------------------------- */

.examine {
    position: absolute;
    left: 24px;
    top: 50%;
    translate: 0 -50%;
    width: 300px;
    max-height: 88%;
    padding: 14px 16px 16px 16px;
    background-color: var(--hud-panel-solid);
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--hud-edge);
    display: none;
}

.examine--visible {
    display: flex;
}

.examine-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
}

.examine-titles {
    flex-shrink: 1;
}

.examine-title {
    color: var(--hud-text);
    font-size: 20px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.examine-subtitle {
    color: var(--hud-accent);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin: 2px 0 0 0;
    padding: 0;
}

.examine--theirs .examine-subtitle {
    color: var(--hud-theirs);
}

.examine-close {
    width: 26px;
    height: 26px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 13px;
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--hud-text-dim);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.examine-close:hover {
    background-color: rgba(255, 255, 255, 0.16);
    color: var(--hud-text);
}

.examine-stats {
    color: var(--hud-text);
    font-size: 12px;
    -unity-font-style: bold;
    margin: 8px 0 0 0;
    padding: 0;
}

.examine-description {
    color: var(--hud-text-dim);
    font-size: 12px;
    white-space: normal;
    margin: 6px 0 0 0;
    padding: 0;
}

.examine-caption {
    color: var(--hud-text-faint);
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin: 14px 0 6px 0;
    padding: 0;
}

.examine-group {
    margin: 6px 0 2px 0;
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: var(--hud-text-faint);
}

.examine-abilities {
    flex-direction: column;
}

.examine-entry {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin: 2px 0;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.05);
}

.examine-entry--hidden {
    opacity: 0.55;
}

.examine-entry-icon {
    width: 26px;
    height: 26px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
    justify-content: center;
    align-items: center;
}

.examine-entry-glyph {
    color: var(--hud-text);
    font-size: 15px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.examine-entry-text {
    flex-shrink: 1;
}

.examine-entry-name {
    color: var(--hud-text);
    font-size: 13px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.examine-entry--hidden .examine-entry-name {
    -unity-font-style: italic;
}

.examine-entry-desc {
    color: var(--hud-text-dim);
    font-size: 11px;
    white-space: normal;
    margin: 1px 0 0 0;
    padding: 0;
}

/* ---- action bar ------------------------------------------------------------------------------ */

.action-bar {
    position: absolute;
    bottom: 20px;
    left: 50%;
    translate: -50% 0;
    flex-direction: row;
    align-items: flex-end;
    padding: 6px 8px 8px 8px;
    background-color: var(--hud-panel);
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--hud-edge);
}

.action-group {
    flex-direction: column;
    align-items: center;
    padding: 0 6px;
}

.action-group-caption {
    color: var(--hud-text-faint);
    font-size: 9px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    margin: 0 0 5px 0;
    padding: 0;
}

.action-group-row {
    flex-direction: row;
}

.action-group-divider {
    width: 1px;
    height: 56px;
    margin: 0 2px 4px 2px;
    background-color: rgba(255, 255, 255, 0.1);
}

.action-slot {
    width: 60px;
    height: 60px;
    margin: 0 3px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(255, 255, 255, 0.06);
    justify-content: center;
    align-items: center;
    transition-property: background-color, border-color, scale;
    transition-duration: 0.1s;
}

.action-slot:hover {
    background-color: rgba(255, 255, 255, 0.13);
    scale: 1.05 1.05;
}

.action-slot--active {
    border-color: var(--hud-accent);
    background-color: var(--hud-accent-soft);
}

.action-slot--disabled {
    opacity: 0.35;
}

.action-slot--disabled:hover {
    background-color: rgba(255, 255, 255, 0.06);
    scale: 1 1;
}

.action-slot--unaffordable {
    opacity: 0.45;
}

.action-cost {
    position: absolute;
    right: 5px;
    bottom: 3px;
    color: var(--hud-text-dim);
    font-size: 11px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.action-slot--unaffordable .action-cost {
    color: var(--hud-ap-reserved);
}

.ap-row {
    flex-direction: row;
    align-items: center;
    height: 60px;
}

.ap-dot {
    width: 12px;
    height: 12px;
    margin: 0 3px;
    border-radius: 6px;
    background-color: var(--hud-ap);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.4);
    transition-property: background-color;
    transition-duration: 0.1s;
}

.ap-dot--empty {
    background-color: var(--hud-ap-empty);
}

.ap-dot--reserved {
    background-color: var(--hud-ap-reserved);
}

.action-icon {
    width: 38px;
    height: 38px;
    -unity-background-scale-mode: scale-to-fit;
}

.action-glyph {
    color: var(--hud-text);
    font-size: 26px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* ---- tooltip --------------------------------------------------------------------------------- */

.tooltip {
    position: absolute;
    bottom: 118px;
    left: 50%;
    translate: -50% 0;
    max-width: 340px;
    padding: 8px 12px;
    background-color: var(--hud-panel-solid);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--hud-edge);
    display: none;
}

.tooltip--visible {
    display: flex;
}

.tooltip-title {
    color: var(--hud-text);
    font-size: 14px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.tooltip-detail {
    color: var(--hud-accent);
    font-size: 11px;
    white-space: normal;
    margin: 3px 0 0 0;
    padding: 0;
}

.tooltip-body {
    color: var(--hud-text-dim);
    font-size: 12px;
    white-space: normal;
    margin: 4px 0 0 0;
    padding: 0;
}

/* ---- end turn -------------------------------------------------------------------------------- */

.end-turn {
    position: absolute;
    right: 24px;
    bottom: 24px;
    margin: 0;
    padding: 14px 28px;
    align-items: center;
    background-color: var(--hud-end);
    border-radius: 12px;
    border-width: 0;
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.end-turn:hover {
    background-color: var(--hud-end-hover);
    scale: 1.03 1.03;
}

.end-turn:active {
    scale: 0.97 0.97;
}

.end-turn:disabled {
    opacity: 0.3;
}

.end-turn-label {
    color: var(--hud-text);
    font-size: 16px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

/* ---- resign ----------------------------------------------------------------------------------- */

/* Quiet until you touch it, and it asks again before it does anything. */
.resign {
    position: absolute;
    right: 24px;
    bottom: 86px;
    margin: 0;
    padding: 8px 18px;
    background-color: rgba(0, 0, 0, 0);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--hud-edge);
    color: var(--hud-text-faint);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    display: none;
    transition-property: background-color, color;
    transition-duration: 0.12s;
}

.resign--visible {
    display: flex;
}

.resign:hover {
    color: var(--hud-text-dim);
    border-color: var(--hud-text-faint);
}

/* Second click only: the label says so, and it reverts on its own after a few seconds. */
.resign--confirm {
    background-color: var(--hud-end);
    border-color: var(--hud-end);
    color: var(--hud-text);
}

.resign--confirm:hover {
    background-color: var(--hud-end-hover);
    color: var(--hud-text);
}

.resign:disabled {
    opacity: 0.25;
}

/* ---- the series line and the draft (design #draft; decided 22 Sep 2026, P1, P2) ---------------- */

/* Which round of the series this is, and the score, above the turn owner. */
.series-line {
    margin: 0 0 4px 0;
    padding: 0;
    color: var(--hud-text-dim);
    font-size: 11px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    display: none;
}

.series-line--visible {
    display: flex;
}

/* The whole draft, over the board. Hidden unless a draft is open. */
.draft-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.draft-panel--visible {
    display: flex;
}

/* What dims the board: one element, no shader change, and it darkens the heroes too. */
.draft-scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.72);
}

.draft-body {
    align-items: center;
    padding: 24px 28px;
    max-width: 860px;
}

.draft-headline {
    margin: 0;
    color: var(--hud-text);
    font-size: 20px;
    letter-spacing: 6px;
    -unity-font-style: bold;
}

.draft-next {
    margin-top: 8px;
    color: var(--hud-text-dim);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.draft-cards {
    flex-direction: row;
    margin-top: 20px;
}

.draft-card {
    width: 232px;
    margin: 0 8px;
    padding: 16px 16px 18px 16px;
    background-color: var(--hud-panel-solid);
    border-radius: 14px;
    border-width: 2px;
    border-color: var(--hud-edge);
    transition-property: border-color, scale, background-color;
    transition-duration: 0.1s;
}

.draft-card:hover {
    scale: 1.02 1.02;
    border-color: var(--hud-text-faint);
}

.draft-card--selected {
    border-color: var(--hud-accent);
    background-color: var(--hud-accent-soft);
}

/* One hue per kind, so the three are told apart before they are read. */
.card-kind {
    margin: 0;
    font-size: 10px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--hud-text-faint);
}

.kind--blessing { color: rgb(255, 214, 120); }
.kind--enchant { color: rgb(150, 210, 255); }
.kind--sigil { color: rgb(200, 160, 255); }

.card-name {
    margin-top: 6px;
    color: var(--hud-text);
    font-size: 17px;
    -unity-font-style: bold;
    white-space: normal;
}

.card-god {
    margin-top: 2px;
    color: var(--hud-text-dim);
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
}

.card-effect {
    margin-top: 12px;
    color: var(--hud-text-dim);
    font-size: 12px;
    white-space: normal;
}

.card-attach {
    margin-top: 12px;
    color: var(--hud-accent);
    font-size: 11px;
    letter-spacing: 1px;
    -unity-font-style: bold;
}

/* One bar for both seats: the draft has one deadline, not a turn each. */
.draft-timer-track {
    margin-top: 22px;
    width: 420px;
    height: 6px;
    background-color: var(--hud-hp-empty);
    border-radius: 3px;
    overflow: hidden;
}

.draft-timer-fill {
    height: 100%;
    width: 100%;
    background-color: var(--hud-accent);
}

.draft-footer {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

/* Green when the other seat has chosen; invisible until then. */
.draft-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background-color: var(--hud-hp);
    margin-right: 8px;
    display: none;
}

.draft-dot--visible {
    display: flex;
}

.draft-status {
    color: var(--hud-text-dim);
    font-size: 12px;
    letter-spacing: 1px;
    margin-right: 18px;
}

.draft-confirm {
    padding: 10px 26px;
    background-color: var(--hud-panel-solid);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--hud-accent);
    color: var(--hud-text);
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.draft-confirm:hover {
    background-color: var(--hud-accent-soft);
    scale: 1.03 1.03;
}

.draft-confirm:disabled {
    opacity: 0.35;
    border-color: var(--hud-edge);
}

/* ---- what a boon changed (ADR-034) ------------------------------------------------------------ */

/* A small mark on a button whose cost, range or damage a boon moved. The number on it is already the
   changed one; this only says why it is not the number on the item. */
.action--modified {
    border-color: rgb(255, 214, 120);
}

/* The god on the nameplate, once something has revealed it. */
.tag-lineage {
    margin-top: 2px;
    color: var(--hud-text-dim);
    font-size: 9px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* The examine panel's body scrolls: gear, abilities, passives and boons together are taller than the
   screen on a fully-drafted hero, and the boons are the newest thing on it. */
.examine-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.examine-body > .unity-scroll-view__content-viewport {
    flex-grow: 1;
}
