/* Lobby and room. One centred column, the same palette as the match HUD, nothing else on screen. */

:root {
    --lobby-bg: rgb(10, 12, 17);
    --panel: rgba(18, 21, 28, 0.94);
    --edge: rgba(255, 255, 255, 0.08);
    --text: rgb(240, 242, 246);
    --text-dim: rgba(240, 242, 246, 0.6);
    --text-faint: rgba(240, 242, 246, 0.35);
    --accent: rgb(120, 200, 255);
    --accent-soft: rgba(120, 200, 255, 0.16);
    --field: rgba(255, 255, 255, 0.06);
    --good: rgb(120, 230, 120);
}

.lobby-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: var(--lobby-bg);
}

.panel {
    width: 480px;
    max-width: 92%;
    padding: 32px 36px 28px 36px;
    background-color: var(--panel);
    border-radius: 18px;
    border-width: 1px;
    border-color: var(--edge);
    display: none;
}

.panel--visible {
    display: flex;
}

.title {
    align-self: center;
    margin-bottom: 4px;
    color: var(--text);
    font-size: 40px;
    letter-spacing: 14px;
    -unity-font-style: bold;
}

/* "Victory vs Random Bot · by elimination". Hidden until there is one. */
.last-result {
    align-self: center;
    margin-bottom: 18px;
    color: var(--text-dim);
    font-size: 12px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    display: none;
}

.last-result--visible {
    display: flex;
}

.field-label {
    margin-top: 14px;
    margin-bottom: 6px;
    color: var(--text-faint);
    font-size: 11px;
    letter-spacing: 3px;
    -unity-font-style: bold;
}

.field {
    margin: 0;
}

.field > .unity-base-field__input,
.field > .unity-base-text-field__input,
.field .unity-base-popup-field__input {
    background-color: var(--field);
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--edge);
    padding: 9px 12px;
    color: var(--text);
    font-size: 15px;
}

/* A room code is four characters and always upper case: give it room and spacing to be read aloud. */
.field--code {
    flex-grow: 1;
    margin-right: 10px;
}

.field--code > .unity-base-text-field__input {
    font-size: 18px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.join-row {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
}

.button {
    margin-top: 10px;
    padding: 12px 20px;
    background-color: var(--field);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--edge);
    color: var(--text);
    font-size: 15px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    transition-property: background-color, scale;
    transition-duration: 0.1s;
}

.button:hover {
    background-color: var(--accent-soft);
    scale: 1.02 1.02;
}

.button:active {
    scale: 0.98 0.98;
}

.button:disabled {
    opacity: 0.3;
}

.button--primary {
    margin-top: 22px;
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--text);
}

.button--quiet {
    background-color: rgba(0, 0, 0, 0);
    color: var(--text-dim);
    font-size: 13px;
}

.button--join {
    margin-top: 0;
    width: 150px;
}

/* Copy link and Copy code side by side: the link is for a chat window, the code is for a phone call. */
.room-actions {
    flex-direction: row;
    justify-content: center;
}

.room-actions > .button {
    margin-left: 6px;
    margin-right: 6px;
}

.status {
    margin-top: 18px;
    align-self: center;
    color: var(--text-dim);
    font-size: 13px;
    letter-spacing: 1px;
    min-height: 18px;
}

.server {
    margin-top: 10px;
    align-self: center;
    color: var(--text-faint);
    font-size: 10px;
    letter-spacing: 1px;
}

/* ---- room ------------------------------------------------------------------------------------- */

.room-code {
    align-self: center;
    margin-bottom: 4px;
    color: var(--accent);
    font-size: 52px;
    letter-spacing: 16px;
    -unity-font-style: bold;
}

.seats {
    margin-top: 22px;
    padding: 12px 14px;
    background-color: var(--field);
    border-radius: 12px;
}

.seat {
    color: var(--text);
    font-size: 14px;
    padding: 4px 0;
}

.seat--ready {
    color: var(--good);
}

.seat--empty {
    color: var(--text-faint);
}

/* ---- the lineage row (design #lineage; decided 22 Sep 2026) ------------------------------------ */
/* Three gods side by side under the preset. The column is at most 480 px, so each card is a third of
   it with the name, the one-line description and what it starts you with; under 400 px they stack. */

/* USS has no media queries, so the row wraps instead: three across at 480 px, stacked when the column
   is too narrow for a 120 px card. */
.lineage-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.lineage {
    flex-grow: 1;
    flex-basis: 120px;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    padding: 10px 8px;
    font-size: 13px;
    letter-spacing: 0;
    white-space: normal;
    -unity-text-align: upper-left;
    color: var(--text-dim);
}

.lineage--selected {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--text);
}
