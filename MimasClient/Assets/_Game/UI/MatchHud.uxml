<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="MatchHud.uss" />
    <ui:Template name="Examine" src="Examine.uxml" />
    <ui:Template name="HoverPanel" src="HoverPanel.uxml" />
    <ui:VisualElement name="hud-root" class="hud-root" picking-mode="Ignore">

        <!-- Under everything: one floating tag per unit (hp bar, number, passives), anchored to the world each frame. -->
        <ui:VisualElement name="unit-layer" class="unit-layer" picking-mode="Ignore" />

        <!-- Attack preview: line items anchored above the hovered target. -->
        <ui:VisualElement name="preview" class="preview" picking-mode="Ignore">
            <ui:VisualElement class="preview-header" picking-mode="Ignore">
                <ui:Label name="preview-title" class="preview-title" text="Fire Bolt" picking-mode="Ignore" />
                <ui:Label name="preview-total" class="preview-total" text="11" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="preview-blocked" class="preview-blocked" text="No line of sight" picking-mode="Ignore" />
            <ui:VisualElement name="preview-lines" class="preview-lines" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Damage flyovers spawn here. -->
        <ui:VisualElement name="fly-layer" class="fly-layer" picking-mode="Ignore" />

        <!-- Rides next to the pointer while aiming: why this shot cannot be taken. -->
        <ui:Label name="cursor-tag" class="cursor-tag" text="Out of range" picking-mode="Ignore" />

        <!-- Top centre: whose turn. No numbers; a rope burns down for the last seconds (ADR-015). -->
        <ui:VisualElement name="turn-panel" class="turn-panel">
            <!-- Which round of the series this is, and the score, your own first (P2). -->
            <ui:Label name="series-line" class="series-line" text="ROUND 2 · 0 – 1" picking-mode="Ignore" />
            <ui:Label name="turn-owner" class="turn-owner" text="YOUR TURN" />
            <ui:VisualElement name="rope" class="rope" picking-mode="Ignore">
                <ui:VisualElement name="rope-track" class="rope-track" picking-mode="Ignore">
                    <ui:VisualElement name="rope-fill" class="rope-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="rope-ember" class="rope-ember" picking-mode="Ignore" />
            </ui:VisualElement>
            <!-- Only online, and only when there is something to say: the opponent is gone, and for how long. -->
            <ui:Label name="status-line" class="status-line" text="Opponent disconnected · 47 s" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- Centre: match result, how it ended, and the way out of it. -->
        <ui:VisualElement name="banner-panel" class="banner-panel" picking-mode="Ignore">
            <ui:Label name="banner" class="banner" text="VICTORY" picking-mode="Ignore" />
            <ui:Label name="banner-detail" class="banner-detail" text="by elimination" picking-mode="Ignore" />
            <ui:Button name="banner-button" class="banner-button" text="Back to lobby" />
        </ui:VisualElement>

        <!-- Bottom centre: action points, then one section per category, filled at runtime from IMatchHudSource. -->
        <ui:VisualElement name="tooltip" class="tooltip" picking-mode="Ignore">
            <ui:Label name="tooltip-title" class="tooltip-title" text="Move" />
            <ui:Label name="tooltip-detail" class="tooltip-detail" text="Lobbed · no sight needed · range 1-5" />
            <ui:Label name="tooltip-body" class="tooltip-body" text="Walk to an adjacent tile." />
        </ui:VisualElement>
        <ui:VisualElement name="action-bar" class="action-bar" />

        <!-- Bottom right: pass the turn early, and give it up entirely. -->
        <ui:Button name="end-turn" class="end-turn">
            <ui:Label name="end-turn-label" class="end-turn-label" text="END TURN" picking-mode="Ignore" />
        </ui:Button>

        <!-- Two clicks, because conceding by accident is the worst possible misclick. -->
        <ui:Button name="resign" class="resign" text="RESIGN" />

        <!-- Between rounds: the draft over the dimmed board (P1). The scrim is what dims it — no shader
             change, and it darkens the heroes too. Three cards are built in code into draft-cards. -->
        <ui:VisualElement name="draft-panel" class="draft-panel">
            <ui:VisualElement name="draft-scrim" class="draft-scrim" />
            <ui:VisualElement name="draft-body" class="draft-body">
                <ui:Label name="draft-headline" class="draft-headline" text="ROUND 1 LOST · 0 – 1" picking-mode="Ignore" />
                <ui:Label name="draft-next" class="draft-next" text="Choose one boon · Round 2 on Board" picking-mode="Ignore" />
                <ui:VisualElement name="draft-cards" class="draft-cards" />
                <ui:VisualElement name="draft-timer-track" class="draft-timer-track" picking-mode="Ignore">
                    <ui:VisualElement name="draft-timer-fill" class="draft-timer-fill" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="draft-footer">
                    <ui:VisualElement name="draft-dot" class="draft-dot" picking-mode="Ignore" />
                    <ui:Label name="draft-status" class="draft-status" text="" picking-mode="Ignore" />
                    <ui:Button name="draft-confirm" class="draft-confirm" text="Confirm" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Right: the examine plate (docs/ui/examine.md), driven by ExamineView. Last but one in the tree, so
             it is a layer over the whole HUD: it covers End Turn rather than moving it. -->
        <ui:Instance template="Examine" name="examine-mount" picking-mode="Ignore" />

        <!-- The one hover panel, over everything (docs/ui/language.md §6). -->
        <ui:Instance template="HoverPanel" name="hover-mount" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
