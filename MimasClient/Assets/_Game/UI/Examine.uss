/*
 * The examine plate (docs/ui/examine.md, spec E §7.3, spec H §7.9). Ink, like every other surface since the
 * HUD session (ADR-040): bone type, names and captions in capitals; no hairlines, no boxed sections: a
 * section is a caption and 18px of air (E3). Every colour, face and size is a --mimas-* token from
 * Theme.uss; this file holds no literal colour and no font file. The owner's accent is --ex-accent, set
 * once by ex--mine / ex--theirs.
 */

.ex-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ex--mine {
    --ex-accent: var(--mimas-you);
}

.ex--theirs {
    --ex-accent: var(--mimas-them);
}

/* ---- the wash ---------------------------------------------------------------------------------- */

/* A white ramp drawn by the view, tinted to the wash token: ink at 45% at the plate, nothing 200px out. */
.ex-wash {
    position: absolute;
    top: 0;
    bottom: 0;
    right: var(--mimas-plate-w);
    width: 200px;
    -unity-background-image-tint-color: var(--mimas-wash);
    -unity-background-scale-mode: stretch-to-fill;
    display: none;
}

.ex--open .ex-wash {
    display: flex;
}

/* ---- the plate --------------------------------------------------------------------------------- */

.ex-plate {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: var(--mimas-plate-w);
    background-color: var(--mimas-ink);
    padding-top: var(--mimas-plate-pad);
    padding-bottom: 0;
    padding-left: var(--mimas-plate-pad-x);
    padding-right: var(--mimas-plate-pad-x);
    overflow: hidden;
    display: none;
}

/* A layer over the HUD: it is there or it is not. No slide, and nothing else moves for it. */
.ex--open .ex-plate {
    display: flex;
}

/* The painting bleeds to the plate's edges; its height is set by the view (210, or 120 below 900px). */
.ex-portrait {
    margin-top: -22px;                              /* bleeds through --mimas-plate-pad */
    margin-left: -22px;                             /* and through --mimas-plate-pad-x */
    margin-right: -22px;
    height: 210px;
    flex-shrink: 0;
    justify-content: flex-end;
    padding-left: var(--mimas-plate-pad-x);
    padding-right: var(--mimas-plate-pad-x);
    padding-bottom: 10px;
    -unity-background-scale-mode: stretch-to-fill;
}

.ex--short .ex-portrait {
    height: 120px;
}

.ex-emblem {
    position: absolute;
    right: -26px;
    top: -8px;
    width: 220px;
    height: 220px;
    opacity: 0.5;
    --glyph-stroke: 1.2;
}

.ex--short .ex-emblem {
    width: 130px;
    height: 130px;
    right: -10px;
    top: -6px;
}

.ex-titles {
    flex-direction: column;
}

.ex-name {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-28);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
}

.ex-lineage {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-12);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--ex-accent);
    margin: 4px 0 0 0;
    padding: 0;
}

.ex-close {
    position: absolute;
    right: 14px;
    top: 14px;
    width: 22px;
    height: 22px;
    align-items: center;
    justify-content: center;
}

.ex-close-glyph {
    width: 14px;
    height: 14px;
    --glyph-color: var(--mimas-fg-3);
}

.ex-close:hover .ex-close-glyph {
    --glyph-color: var(--mimas-fg);
}

/* ---- the scrolling body ------------------------------------------------------------------------ */

.ex-body {
    flex-grow: 1;
    flex-shrink: 1;
}

.ex-body .unity-scroll-view__content-container {
    padding-top: 10px;
    padding-bottom: 14px;
    padding-right: 6px;
}

/* A 2px scroller in the hair colour: no arrows, no track. */
.ex-body .unity-scroller--vertical {
    width: 2px;
    min-width: 2px;
    border-width: 0;
    background-color: var(--mimas-clear);
}

.ex-body .unity-scroller--vertical .unity-scroller__low-button,
.ex-body .unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.ex-body .unity-scroller--vertical .unity-slider {
    margin: 0;
    width: 2px;
}

.ex-body .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--mimas-clear);
    border-width: 0;
}

.ex-body .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--mimas-hair);
    border-width: 0;
    width: 2px;
    left: 0;
}

.ex-body .unity-scroller--vertical .unity-base-slider__dragger-border {
    display: none;
}

/* Rows that open the hover panel get the faint hover ground (language §5 state.hover). */
.ex-row:hover {
    background-color: var(--mimas-hover);
}

/* ---- vitals ------------------------------------------------------------------------------------ */

.ex-vitals {
    flex-direction: column;
    margin-bottom: var(--mimas-gap-section);
}

.ex-vital {
    flex-direction: row;
    align-items: center;
    height: 40px;
}

.ex-vitals-second {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ex-vital-glyph {
    width: 18px;
    height: 18px;
    margin-right: 10px;
}

.ex-accent-glyph {
    --glyph-color: var(--ex-accent);
}

.ex-vital-value {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-38);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
    min-width: 22px;
}

.ex-vital-max {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-12);
    color: var(--mimas-fg-3);
    margin: 6px 0 0 8px;
    padding: 0;
}

.ex-bar {
    flex-grow: 1;
    height: var(--mimas-bar);
    margin-left: 18px;
    background-color: var(--mimas-hair);
}

.ex-bar-fill {
    height: var(--mimas-bar);
    background-color: var(--ex-accent);
}

.ex-eggs {
    flex-direction: row;
    margin-left: 14px;
}

.ex-egg {
    width: 13px;
    height: 13px;
    margin-right: 4px;
    --glyph-color: var(--ex-accent);
    --glyph-stroke: 2.4;
}

.ex-height {
    flex-direction: row;
    align-items: center;
}

.ex-height-glyph {
    width: 16px;
    height: 16px;
    margin-right: 6px;
    --glyph-color: var(--mimas-fg-3);
}

.ex-height-value {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-20);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
}

.ex-height-caption {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-caps-tracking);
    color: var(--mimas-fg-3);
    margin: 3px 0 0 6px;
    padding: 0;
}

.ex-description {
    -unity-font-definition: var(--mimas-font-body);
    font-size: var(--mimas-text-14);
    color: var(--mimas-fg-2);
    white-space: normal;
    margin: 0;
    margin-bottom: var(--mimas-gap-section);
    padding: 0;
    display: none;
}

.ex--prop .ex-description {
    display: flex;
}

/* A prop's plate is name, height and health only (§13). */
.ex--prop .ex-caption,
.ex--prop .ex-stats,
.ex--prop .ex-boons,
.ex--prop .ex-equipment,
.ex--prop .ex-eggs,
.ex--prop .ex-vitals-second > .ex-vital {
    display: none;
}

/* ---- section captions: a caption and air, never a line ----------------------------------------- */

.ex-caption {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-caps-tracking-wide);
    color: var(--ex-accent);
    margin: 0 0 4px 0;
    padding: 0;
}

/* ---- stats: a 3×2 grid of base, net, glyph and caption ------------------------------------------ */

.ex-stats {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: var(--mimas-gap-section);
}

.ex-stat {
    width: 33.33%;
    flex-direction: column;
    padding: 2px 0 4px 0;
}

.ex-stat-numbers {
    flex-direction: row;
    align-items: flex-end;
}

.ex-stat-base {
    -unity-font-definition: var(--mimas-font-display);
    font-size: var(--mimas-text-28);
    color: var(--mimas-fg);
    margin: 0;
    padding: 0;
}

.ex-stat-net {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-14);
    margin: 0 0 4px 6px;
    padding: 0;
}

.ex-stat-net--up {
    color: var(--mimas-up);
}

.ex-stat-net--down {
    color: var(--mimas-down);
}

.ex-stat-net--hidden {
    color: var(--mimas-fg-3);
}

.ex-stat-label {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.ex-stat-glyph {
    width: 11px;
    height: 11px;
    margin-right: 5px;
    --glyph-color: var(--mimas-fg-3);
}

.ex-stat-caption {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-11);
    letter-spacing: var(--mimas-caps-tracking);
    color: var(--mimas-fg-3);
    margin: 0;
    padding: 0;
    white-space: normal;
    max-width: 104px;
}

/* ---- boons ------------------------------------------------------------------------------------- */

.ex-boons {
    flex-direction: column;
    margin-bottom: var(--mimas-gap-section);
}

.ex-boon {
    flex-direction: row;
    align-items: center;
    height: 28px;
    margin-bottom: var(--mimas-gap-row);
}

.ex-boon-glyph {
    width: 14px;
    height: 14px;
    margin-right: 14px;
    --glyph-color: var(--ex-accent);
}

.ex-boon-name {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-14);
    letter-spacing: var(--mimas-caps-tracking);
    color: var(--mimas-fg);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.ex-boon-on {
    -unity-font-definition: var(--mimas-font-body);
    font-size: var(--mimas-text-12);
    color: var(--mimas-fg-3);
    margin: 0;
    padding: 0;
}

.ex-boon--unrevealed .ex-boon-glyph {
    --glyph-color: var(--mimas-fg-3);
}

.ex-boon--unrevealed .ex-boon-name {
    color: var(--mimas-fg-3);
}

.glyph-question {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-10);
    margin: 0;
    padding: 0;
}

/* ---- equipment and tiles ----------------------------------------------------------------------- */

.ex-equipment {
    flex-direction: column;
}

.ex-item {
    flex-direction: column;
    margin-bottom: var(--mimas-gap-item);
}

.ex-item-head {
    flex-direction: row;
    align-items: center;
    height: 34px;
}

.ex-item-square {
    width: 30px;
    height: 30px;
    margin-right: 10px;
    -unity-background-scale-mode: stretch-to-fill;
    align-items: center;
    justify-content: center;
}

.ex-item-slot-glyph {
    width: 14px;
    height: 14px;
    --glyph-color: var(--mimas-ink);
    opacity: 0.7;
}

.ex-item-name {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-15);
    letter-spacing: var(--mimas-caps-tracking);
    color: var(--mimas-fg);
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.ex-item-stat {
    -unity-font-definition: var(--mimas-font-body);
    font-size: var(--mimas-text-12);
    color: var(--mimas-up);
    margin: 0;
    padding: 0;
}

.ex-item-note {
    -unity-font-definition: var(--mimas-font-body);
    font-size: var(--mimas-text-12);
    color: var(--mimas-fg-3);
    margin: 2px 0 0 40px;
    padding: 0;
}

.ex-tiles {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 2px 0 0 40px;
}

.ex-tile {
    width: 76px;
    align-items: center;
    margin-right: 0;
    margin-bottom: 0;
}

.ex-tile-box {
    width: var(--mimas-tile-size);
    height: var(--mimas-tile-size);
    background-color: var(--mimas-tile);
    border-width: 1px;
    border-color: var(--mimas-hair);
    align-items: center;
    justify-content: center;
}

.ex-tile-letter {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-15);
    color: var(--mimas-fg-2);
    margin: 0;
    padding: 0;
}

.ex-tile-name {
    -unity-font-definition: var(--mimas-font-caps);
    font-size: var(--mimas-text-10);
    letter-spacing: var(--mimas-caps-tracking);
    color: var(--mimas-fg-3);
    -unity-text-align: upper-center;
    margin: 3px 0 0 0;
    padding: 0 2px 0 2px;
    width: 100%;
    white-space: normal;
}

.ex-tile--changed .ex-tile-box,
.ex-tile--added .ex-tile-box {
    border-color: var(--mimas-changed);
}

.ex-tile-mark {
    position: absolute;
    right: -4px;
    top: -5px;
    width: 9px;
    height: 9px;
    --glyph-color: var(--mimas-changed);
}

/* An unseen tile is drawn by a dashed frame, not a border: USS has no dashed border. */
.ex-tile--unseen .ex-tile-box {
    border-width: 0;
    background-color: var(--mimas-clear);
}

.ex-tile-dash {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --glyph-color: var(--mimas-fg-3);
}

.ex-tile--unseen .ex-tile-letter {
    color: var(--mimas-fg-3);
}
