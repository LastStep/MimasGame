/*
 * The Mimas interface language as USS variables (docs/ui/language.md). Every colour, face, size and gap
 * a screen in the new language uses is declared here once and nowhere else; Examine.uss,
 * HoverPanel.uss and MatchHud.uss contain no literal colour or font. Imported first by MatchHud.uss and
 * Lobby.uss.
 *
 * One surface: ink (decided 23 Sep 2026, HUD session round 3, ADR-040). The board HUD, the hover panel,
 * the examine plate, the draft cards, the round band and the lobby are all ink; the second surface and its
 * face are retired and no longer declared.
 */

:root {
    /* ---- §1 colour ---- */
    --mimas-ink: #0b0b0e;
    --mimas-ink-2: #121217;
    --mimas-fg: #efe9dc;
    --mimas-fg-2: rgba(239, 233, 220, 0.74);
    --mimas-fg-3: rgba(239, 233, 220, 0.50);
    --mimas-hair: rgba(239, 233, 220, 0.14);
    --mimas-tile: rgba(0, 0, 0, 0.32);
    --mimas-you: #5fd3c8;
    --mimas-them: #ff4b3e;
    --mimas-amount: #e9b45c;
    --mimas-changed: #a99cff;
    --mimas-up: #8fdc7a;
    --mimas-down: #ff6a5c;

    /* `you` at the alphas the action-bar states use (§5): armed 10%, primary buttons 14%, done 18%, spends 28%. */
    --mimas-you-10: rgba(95, 211, 200, 0.10);
    --mimas-you-14: rgba(95, 211, 200, 0.14);
    --mimas-you-18: rgba(95, 211, 200, 0.18);
    --mimas-you-28: rgba(95, 211, 200, 0.28);

    /* `you` at 55%: the edge of End Turn and the Confirm/Back buttons (§1 "tile edges (at 55%)"). */
    --mimas-you-55: rgba(95, 211, 200, 0.55);

    /* Ink at the alphas the HUD lays over the board: a tag's bar ground (50%), End Turn and the boon circles (55%),
       the cursor tag (82%). */
    --mimas-ink-50: rgba(11, 11, 14, 0.50);
    --mimas-ink-55: rgba(11, 11, 14, 0.55);
    --mimas-ink-82: rgba(11, 11, 14, 0.82);

    /* The round moments' band (§1 band) and the draft's scrim over the board. */
    --mimas-band: rgba(11, 11, 14, 0.86);
    --mimas-scrim: rgba(11, 11, 14, 0.80);

    /* The floors under the bar and the track (docs/ui/hud.md §2): tints for Ramps.Vertical. */
    --mimas-floor: rgba(11, 11, 14, 0.86);
    --mimas-floor-top: rgba(11, 11, 14, 0.62);

    /* The lobby and the room (docs/ui/lobby.md, T-0014): a selected lineage row (`you` at 7%); a plain button's
       edge (bone at 22%) and ground, also the unselected lineage row's (ink at 25%); the server line (bone at 30%). */
    --mimas-you-07: rgba(95, 211, 200, 0.07);
    --mimas-bone-22: rgba(239, 233, 220, 0.22);
    --mimas-bone-30: rgba(239, 233, 220, 0.30);
    --mimas-ink-25: rgba(11, 11, 14, 0.25);

    /* Row hover ground (§5 state.hover: fg at 4.5%). */
    --mimas-hover: rgba(239, 233, 220, 0.045);

    /* The ground under a number tile in the hover panel (§6: "on a 4% ground"). */
    --mimas-number-ground: rgba(239, 233, 220, 0.04);

    /* Nothing: a transparent ground, so no stylesheet needs a literal for it. */
    --mimas-clear: rgba(0, 0, 0, 0);

    /* The wash the plate throws on the board: ink at 45% (docs/ui/examine.md §3.5). */
    --mimas-wash: rgba(11, 11, 14, 0.45);

    /* ---- §2 type: faces (Latin subsets, SIL OFL; Josefin Sans unmodified) ---- */
    --mimas-font-display: url("Fonts/JosefinSans-Light SDF.asset");
    --mimas-font-caps: url("Fonts/JosefinSans-Regular SDF.asset");
    --mimas-font-body: url("Fonts/Sora-Regular SDF.asset");

    /* ---- §2 type: the scale (raised 23 Sep 2026 for readability: nothing under 10px at 1080, and the
       HUD scales down with the window, so 1280×720 draws these at two thirds). A new size is a decision:
       56 is the room code's alone (docs/ui/lobby.md). */
    --mimas-text-56: 56px;
    --mimas-text-38: 38px;
    --mimas-text-36: 36px;
    --mimas-text-28: 28px;
    --mimas-text-20: 20px;
    --mimas-text-19: 19px;
    --mimas-text-17: 17px;
    --mimas-text-15: 15px;
    --mimas-text-14: 14px;
    --mimas-text-13: 13px;
    --mimas-text-12: 12px;
    --mimas-text-11: 11px;
    --mimas-text-10: 10px;

    /* display-caps letter-spacing (language §2: 0.14–0.28em). UI Toolkit's text generator in 6000.4 reads
       letter-spacing in hundredths of an em whatever the unit says — measured 23 Sep 2026 (T-0013): a label
       at 15px with `letter-spacing: 100px` gains 15px per gap — so these values are em × 100: 16px is 0.16em.
       Until then they were written as pixels (1px, 2px) and drew as almost nothing. */
    --mimas-caps-tracking: 8px;
    --mimas-caps-tracking-wide: 14px;

    /* The HUD's wider tracking (docs/ui/hud.md, between-rounds.md), also em × 100: captions 0.28em, the track's
       names and End Turn 0.24em, headlines 0.28em, the band's titles 0.30em. */
    --mimas-tracking-11: 28px;
    --mimas-tracking-15: 24px;
    --mimas-tracking-20: 28px;
    --mimas-tracking-38: 30px;

    /* The lobby's two wide ones, also em × 100 (docs/ui/lobby.md): the MIMAS title at 0.60em, the room code and the
       code field at 0.50em. */
    --mimas-tracking-title: 60px;
    --mimas-tracking-code: 50px;

    /* ---- §4 space and shape ---- */
    --mimas-plate-w: 420px;
    --mimas-plate-pad: 22px;
    --mimas-plate-pad-x: 22px;
    --mimas-gap-section: 18px;
    --mimas-gap-item: 12px;
    --mimas-gap-row: 5px;
    --mimas-tile-size: 44px;
    --mimas-tile-gap: 8px;
    --mimas-bar: 2px;
    --mimas-panel-w: 340px;
    --mimas-panel-tile: 46px;
    --mimas-panel-edge: 2px;

    /* The HUD's own sizes (language §4): buttons, the turn track, a draft card, the distance from the window edge. */
    --mimas-button-w: 230px;
    --mimas-button-h: 58px;
    --mimas-track-w: 620px;
    --mimas-card-w: 360px;
    --mimas-card-h: 470px;
    --mimas-edge: 40px;

    /* USS has no box-shadow: the panel's shadow is a blurred-looking offset layer in this colour (drift). */
    --mimas-shadow-panel: rgba(0, 0, 0, 0.6);
    --mimas-shadow-offset: 14px;
}
